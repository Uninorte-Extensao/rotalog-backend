# Copie para .env, preencha os campos vazios e proteja o arquivo (chmod 600).
# Gere cada valor separadamente: python -c "import secrets; print(secrets.token_urlsafe(48))"
# POSTGRES_PASSWORD deve ser URL-safe para a URL construída no Compose.
POSTGRES_PASSWORD=
ROTALOG_JWT_SECRET=
ROTALOG_DEMO_PASSWORD=
ROTALOG_ENVIRONMENT=development
ROTALOG_DEBUG=false
ROTALOG_DEMO_ENABLED=true
# Produção: false; o seed deixa de ser executado e emails reais são aceitos.
# Para manter os dados atuais de teste, use o demo_run_id retornado por /me.
ROTALOG_DATA_CONTEXT_ID=
ROTALOG_COOKIE_SECURE=false
ROTALOG_COOKIE_SAMESITE=lax
ROTALOG_CORS_ORIGINS=["http://localhost:5173"]
# Sem Compose: preencha uma URL PostgreSQL 17 dedicada, com a senha URL-encoded.
# Exemplo de formato: postgresql+psycopg://usuario:SENHA@127.0.0.1:5432/rotalog_demo
ROTALOG_DATABASE_URL=
# Testes exigem banco exclusivo cujo nome contenha "test".
ROTALOG_TEST_DATABASE_URL=
# Execução sem Docker: diretório privado, nunca servido como pasta estática.
ROTALOG_PRODUCT_IMAGES_ROOT=.local-runtime/product-images
ROTALOG_PRODUCT_IMAGES_PER_PRODUCT=5
ROTALOG_PRODUCT_IMAGE_MAX_BYTES=8388608
ROTALOG_PRODUCT_IMAGE_MAX_PIXELS=16000000
ROTALOG_PRODUCT_IMAGE_UPLOAD_TTL_SECONDS=900
# Tracking canônico: janela de sincronização após fim, atraso e limites por rota.
ROTALOG_TRACKING_STALE_SECONDS=120
ROTALOG_TRACKING_SYNC_WINDOW_SECONDS=86400
ROTALOG_TRACKING_ACCURACY_WARNING_METERS=100
ROTALOG_TRACKING_BATCHES_PER_MINUTE=20
